# --- EventFlow .gitignore ---------------------------------------------------
# Documentation policy (README.rst): all Markdown and all planning documents
# stay out of Git. Public documentation lives in README.rst; shared results
# are .json / .csv / .rst.

# All Markdown, including agent-internal Markdown instructions, stays local.
*.md
*.markdown
*.mdx

# Plans, PRDs, design notes and private working documents stay local.
planning/
.planning/
plans/
docs/planning/
docs/plans/
*_PRD.*
*.prd
*.plan

# Local agent configuration and skill instructions. The commit skill is
# regenerated by tools/bootstrap_commit_skill.py; the generator is tracked.
.claude/
.agents/

# Python
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
.python-version

# Test / type / coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
